{
  "description": "JFox prompt 记录 - 实时捕获 session UserPromptSubmit，先写本地 spool 再 POST daemon",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/fragment-capture.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
